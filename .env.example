# Export these in your shell; no keys are required for the core prototype.
PORT=3000
HOST=127.0.0.1
HEALTH_SOS_DB=.data/prototype.sqlite
PYTHON=python3
# Optional: scene description only, never unrestricted medical advice.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Vercel paid-AI endpoint remains disabled until the owner explicitly enables it.
HEALTH_SOS_AI_ENABLED=false

# Optional geocoding provider; must expose Nominatim-compatible search/reverse paths.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
